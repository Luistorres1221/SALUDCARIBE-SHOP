# Copia este archivo como .env en la raiz del proyecto y reemplaza todos los valores.
# En EC2, APP_DATA_DIR debe apuntar al volumen EBS montado, por ejemplo /srv/caribeshop.
APP_DATA_DIR=/srv/caribeshop
SITE_ADDRESS=:80

DB_NAME=saludcaribe
DB_USER=saludcaribe_app
DB_PASSWORD=REEMPLAZA_POR_UN_SECRETO_ALEATORIO_HEXADECIMAL

# Usa al menos 32 bytes aleatorios. Generar en Linux: openssl rand -hex 32
JWT_SECRET=REEMPLAZA_POR_64_CARACTERES_HEXADECIMALES

# El frontend y la API comparten origen; no se requieren origenes CORS de produccion.
CORS_ORIGINS=http://localhost:5173

BOOTSTRAP_ADMIN_EMAIL=admin@saludcaribe.com
# Se utiliza solo para crear el administrador cuando aun no existe.
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZA_POR_UNA_CLAVE_TEMPORAL_FUERTE

# Dejar en update para crear/actualizar tablas al primer arranque. Tras respaldar y validar esquema,
# puede cambiarse a validate para impedir cambios automáticos posteriores.
DDL_AUTO=update
